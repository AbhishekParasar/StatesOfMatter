  m_Name: Nitrogen
  m_EditorClassIdentifier: 
  Questions:
  - QuestionText: Which of these substances exists as a liquid at the lowest temperature?
    Options:
    - Oxygen
    - Nitrogen
    - Argon
    - Water
    CorrectOptionIndex: 1
    IsTrueFalse: 0
    CorrectAnswer: 0
    CorrectFeedback: " Great job! Oxegen becomes a liquid at -183\xB0C. This is its
      boiling point where it transitions from a gaseous to a liquid state."
    IncorrectFeedback: "Not quite! The correct answer is nitrogen. It liquefies at
      -196\xB0C, lower than the boiling points of the other options."
  - QuestionText: "Nitrogen changes from liquid to gas at -269\xB0C."
    Options:
    - True
    - False
    CorrectOptionIndex: 1
    IsTrueFalse: 0
    CorrectAnswer: 0
    CorrectFeedback: "Correct! Nitrogen becomes a liquid at -193\xB0C, which is lower
      than the boiling points of oxygen, argon, or water."
    IncorrectFeedback: "Not quite! The correct answer is nitrogen. It liquefies at
      -196\xB0C, lower than the boiling points of the other options."
