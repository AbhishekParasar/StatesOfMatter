  m_Name: Oxygen
  m_EditorClassIdentifier: 
  Questions:
  - QuestionText: At what temperature does oxygen becomes a liquid?
    Options:
    - "-183\xB0C"
    - "-196\xB0C"
    - "0\xB0C"
    - "-270\xB0C"
    CorrectOptionIndex: 0
    IsTrueFalse: 0
    CorrectAnswer: 0
    CorrectFeedback: "Great job! Oxygen becomes a  liquid at -183\xB0C. This is its
      boiling  point where it transitions from a  gaseous to a liquid state."
    IncorrectFeedback: "Not quite! The correct answer is  -183\xB0C. At this temperature,
      oxygen  changes from gas to liquid. Try again!"
  - QuestionText: Oxygen becomes a solid at extremely low temperatures.
    Options:
    - True
    - False
    CorrectOptionIndex: 0
    IsTrueFalse: 0
    CorrectAnswer: 0
    CorrectFeedback: You're right! At very low temperatures, oxygen forms a solid
      and its molecules become tightly packed.
    IncorrectFeedback: Not correct. Oxygen does become solid at extremely low temperatures
      when it freezes.
